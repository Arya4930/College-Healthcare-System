# Migration/rollback only: required when DATABASE_PROVIDER=mongodb or running migration tooling.
MONGODB_URI=
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
# Keep jwt until Cognito setup and user-to-sub mapping are complete.
AUTH_PROVIDER=jwt
# Future Cognito configuration (backend only; do not use VITE_ variables):
# COGNITO_USER_POOL_ID=
# COGNITO_APP_CLIENT_ID=
FRONTEND_URL=http://localhost:5173
PORT=4000
TRUST_PROXY=false

# Local: false. Production: true (also enabled automatically by NODE_ENV=production).
USE_AWS_SECRETS=false
AWS_REGION=local
AWS_SECRET_NAME=

DATABASE_PROVIDER=dynamodb
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_USERS_TABLE=CampusCareUsers
DYNAMODB_APPOINTMENTS_TABLE=CampusCareAppointments
DYNAMODB_MEDICINES_TABLE=CampusCareMedicines
DYNAMODB_ORDERS_TABLE=CampusCareOrders

# Production example (use deployment environment configuration, never commit values):
# NODE_ENV=production
# DATABASE_PROVIDER=dynamodb
# AWS_REGION=ap-southeast-2
# DYNAMODB_ENDPOINT=
# AWS_SECRET_NAME=campuscare/backend
# USE_AWS_SECRETS=true
# TRUST_PROXY=true
# Production CORS: origin only; do not include /College-Healthcare-System/.
# FRONTEND_URL=https://arya4930.github.io
