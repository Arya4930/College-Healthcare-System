# Vite exposes only VITE_* variables to the browser. Never place secrets here.
# Local backend development
VITE_API_URL=http://localhost:4000

# GitHub Pages production build
# VITE_API_URL=https://api-cad.arya22.dev
# VITE_BASE_PATH=/College-Healthcare-System/

# AWS S3 + CloudFront production build (npm run build:aws)
# VITE_API_URL=https://api-cad.arya22.dev
# VITE_BASE_PATH=/
